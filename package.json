{
  "name": "pcosense",
  "version": "1.0.0",
  "private": true,
  "description": "PCOSense – An ML-powered PCOS risk screening application that combines a trained machine learning model with an interactive web interface.",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,frontend\" -c \"cyan.bold,green.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "python backend/run.py",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "test:backend": "python -m unittest backend/test_backend.py",
    "install:frontend": "npm install --prefix frontend",
    "install:all": "npm install && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
